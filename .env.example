# Copy to .env and set a local-only password before starting Docker Compose.
DB_NAME=openrouter_clone
DB_USER=openrouter_app
DB_PASSWORD=
DB_PORT=5432

# Spring Boot datasource; defaults match the PostgreSQL service above.
DB_URL=jdbc:postgresql://localhost:5432/openrouter_clone
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite reads the root .env file via frontend/vite.config.ts.
VITE_API_BASE_URL=http://localhost:8080/api/v1
